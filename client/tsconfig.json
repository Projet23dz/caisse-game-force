{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "rootDir": "src",
    "outDir": "public/js",
    "strict": true,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src"]
}
