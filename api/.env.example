# CashPro API — exemple de configuration.
# Sur le serveur Windows, install-database.ps1 crée automatiquement C:\CashPro\config\cashpro.env
# (l'API le lit en priorité). Ce fichier .env ne sert qu'en développement.

DATABASE_URL=postgresql://cashpro_app:MOT_DE_PASSE@localhost:5432/cashpro
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-64-caracteres
JWT_TTL=12h
HOST=0.0.0.0
PORT=4600
# Dossier des logos et pièces jointes (sous-dossiers logos\ et attachments\)
DATA_DIR=C:\CashPro
MAX_UPLOAD_MB=20
CORS_ORIGINS=*
